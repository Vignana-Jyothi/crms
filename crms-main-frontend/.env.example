# Base URL the frontend calls. In production this is your real API
# domain (e.g. https://crms-api.vjstartup.com); in dev, Vite's proxy
# (see vite.config.js) forwards /api to VITE_API_PROXY_TARGET so you
# don't hit CORS issues locally.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:4000
