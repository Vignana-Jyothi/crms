# Copy to .env.docker and replace every placeholder before starting Docker.
POSTGRES_USER=crms_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=campus_resource_management
POSTGRES_PORT=5466

DATABASE_URL="postgresql://crms_app:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/campus_resource_management"
PORT=4000
NODE_ENV=production
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:18432,http://localhost:18433

EDUPRIME_BASE_URL=https://automation.vnrvjiet.ac.in
EDUPRIME_RELIC_TOKEN=REPLACE_WITH_EDUPRIME_RELIC_TOKEN

# Optional SMTP configuration. Notifications are skipped when it is absent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CRMS Notifications <no-reply@example.com>"

# Required only when manually running npm run seed.
SEED_DEFAULT_PASSWORD=REPLACE_WITH_A_STRONG_TEMPORARY_PASSWORD
